# Warehouse Lens CAP backend - example environment file.
# Copy to .env for local overrides. All values here are PLACEHOLDERS.
# Never commit a real .env, service keys, or credentials.

# Local server port for `cds watch` / `cds serve` (default 4004)
PORT=4004

# --- Cloud deployment (values come from your BTP subaccount; see docs/btp-deployment.md) ---
# These are ONLY needed for cloud deployment tooling (cf CLI / mbt), never at runtime:
# CF_API=https://api.cf.<region>.hana.ondemand.com
# CF_ORG=<your-org>
# CF_SPACE=<your-space>
