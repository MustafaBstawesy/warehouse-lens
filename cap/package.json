{
  "name": "warehouse-lens-cap",
  "version": "1.0.0",
  "description": "Warehouse Lens - CAP OData V4 backend for the MDK mobile client. Internal stock transfer requests: scan a material, check availability across warehouses, submit a transfer request (submitting never reserves or moves stock).",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/hana": "^2.8.1",
    "@cap-js/sqlite": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0",
    "@cap-js/cds-types": "^0.19.0",
    "@sap/cds-dk": "^9",
    "@types/jest": "^29",
    "@types/node": "^22",
    "eslint": "^10.10.0",
    "jest": "^29",
    "ts-jest": "^29",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --port 4004",
    "build": "cds build --production && tsc -p tsconfig.build.json && node -e \"const fs=require('fs'),p=require('path');const walk=d=>fs.readdirSync(d).forEach(f=>{const q=p.join(d,f);fs.statSync(q).isDirectory()?walk(q):q.endsWith('.ts')&&fs.unlinkSync(q)});walk('gen/srv/srv')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint srv test scripts",
    "test": "jest --runInBand",
    "seed": "cds deploy --to sqlite:db.sqlite && tsx scripts/seed-demo.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:advance": "tsx scripts/advance-request.ts"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    }
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alex": {
            "roles": [
              "WarehouseUser"
            ]
          },
          "dana": {
            "roles": [
              "WarehouseUser"
            ]
          },
          "sam": {
            "roles": [
              "WarehouseUser",
              "WarehouseAdmin"
            ]
          },
          "kim": {
            "roles": [
              "WarehouseUser"
            ]
          },
          "bob": {
            "roles": []
          }
        }
      },
      "[test]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": {
          "kind": "hana",
          "impl": "@cap-js/hana"
        }
      }
    },
    "server": {
      "index": true
    },
    "log": {
      "levels": {
        "sqlite": "warn"
      }
    }
  }
}
