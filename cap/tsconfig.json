{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "outDir": "dist",
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@sap/cds": ["./node_modules/@cap-js/cds-types"]
    }
  },
  "include": ["srv/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "gen", "dist"]
}
